# ==============================================================================
# Azure SQL to Microsoft Fabric Ingestion Engine - Frontend Configuration Example
# ==============================================================================

# Backend API Base URL
VITE_API_URL=http://localhost:8000

# Microsoft Fabric Service Principal (OAuth2)
VITE_DEFAULT_TENANT_ID=your-azure-tenant-id
VITE_DEFAULT_CLIENT_ID=your-azure-client-id
VITE_DEFAULT_CLIENT_SECRET=your-azure-client-secret

# Microsoft Fabric Target Environment
VITE_DEFAULT_CAPACITY_ID=your-fabric-capacity-id
VITE_DEFAULT_WORKSPACE_NAME=Data_Migration_Workspace
VITE_DEFAULT_WAREHOUSE_NAME=WH_METADATA
VITE_DEFAULT_LAKEHOUSE_NAME=LH_BRONZE
VITE_DEFAULT_TARGET_SERVER=your-fabric-endpoint.datawarehouse.fabric.microsoft.com

# Source Database Default Parameters
VITE_DEFAULT_SOURCE_SERVER=your-server.database.windows.net
VITE_DEFAULT_SOURCE_DATABASE=your-database
VITE_DEFAULT_SOURCE_USERNAME=your-username
VITE_DEFAULT_SOURCE_PORT=1433

