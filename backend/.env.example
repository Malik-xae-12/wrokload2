# ==============================================================================
# Azure SQL to Microsoft Fabric Ingestion Engine - Backend Configuration Example
# ==============================================================================

PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Microsoft Fabric Service Principal (OAuth2)
DEFAULT_AZURE_TENANT_ID=your-azure-tenant-id
DEFAULT_AZURE_CLIENT_ID=your-azure-client-id
DEFAULT_AZURE_CLIENT_SECRET=your-azure-client-secret

# Fabric Workspace & Artifacts
DEFAULT_FABRIC_CAPACITY_ID=your-fabric-capacity-id
DEFAULT_FABRIC_WORKSPACE=Data_Migration_Workspace
DEFAULT_FABRIC_WAREHOUSE=WH_METADATA
DEFAULT_FABRIC_LAKEHOUSE=LH_BRONZE
DEFAULT_FABRIC_SQL_ENDPOINT=your-fabric-endpoint.datawarehouse.fabric.microsoft.com

# Source Database
DEFAULT_SOURCE_SERVER=your-server.database.windows.net
DEFAULT_SOURCE_DATABASE=your-database
DEFAULT_SOURCE_USERNAME=your-username
DEFAULT_SOURCE_PORT=1433

